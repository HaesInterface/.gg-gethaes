function ESP.line(thick,zi)
    local l=Drawing.new("Line")
    l.Visible=false l.Color=Color3.fromRGB(255,255,255)
    l.Thickness=thick or 1.5 l.ZIndex=zi or 5
    return l
end
function ESP.text(size,zi)
    local t=Drawing.new("Text")
    t.Visible=false t.Color=Color3.fromRGB(255,255,255)
    t.Size=size or 12 t.Font=2 t.Outline=true t.Center=true
    t.ZIndex=zi or 6 t.Text=""
    return t
end
function ESP.circle(zi)
    local c=Drawing.new("Circle")
    c.Visible=false c.Filled=true
    c.Color=Color3.fromRGB(255,255,255) c.Radius=4 c.NumSides=32
    c.Thickness=1 c.ZIndex=zi or 6
    return c
end
function ESP.quad(zi)
    local q=Drawing.new("Quad")
    q.Visible=false q.Filled=true
    q.Color=Color3.fromRGB(255,255,255) q.Thickness=1 q.ZIndex=zi or 5
    return q
end

function ESP.newObj()
    local t={}
    t.boxFull={} for i=1,4 do t.boxFull[i]=ESP.line(1.2,5) end
    t.boxCorner={} for i=1,8 do t.boxCorner[i]=ESP.line(1.5,5) end
    t.fillQuad=ESP.quad(4)
    t.outlineFull={} for i=1,4 do t.outlineFull[i]=ESP.line(3.0,4) end
    t.outlineCorner={} for i=1,8 do t.outlineCorner[i]=ESP.line(3.5,4) end
    t.hpBg=ESP.line(4,4) t.hpBg.Color=Color3.fromRGB(0,0,0)
    t.hpFill=ESP.line(2,5)
    t.name=ESP.text(12,7)
    t.dist=ESP.text(10,6) t.dist.Color=Color3.fromRGB(200,200,220)
    t.hdot=ESP.circle(7)
    t.tracer=ESP.line(1,4)
    t.skel={} for i=1,ESP.MAX_BONES do t.skel[i]=ESP.line(1,3) end
    t._vis=false t._wallFrame=0 t._wallVisible=true
    t._boxChar=nil t._boxSize=nil t._boxOffsets=nil
    t._boneChar=nil t._bones=nil t._boneMiss=false
    return t
end

function ESP.hide(obj)
    local function h(d) if type(d)=="userdata" and d.Visible then d.Visible=false end end
    for _,v in pairs(obj.boxFull) do h(v) end
    for _,v in pairs(obj.boxCorner) do h(v) end
    for _,v in pairs(obj.outlineFull) do h(v) end
    for _,v in pairs(obj.outlineCorner) do h(v) end
    for _,v in pairs(obj.skel) do h(v) end
    h(obj.fillQuad) h(obj.hpBg) h(obj.hpFill)
    h(obj.name) h(obj.dist) h(obj.hdot) h(obj.tracer)
end

function ESP.removeObj(pl)
    local obj=ESP.objs[pl]
    if obj then
        ESP.hide(obj)
        local function tryRem(d) if type(d)=="userdata" then pcall(function() d:Remove() end) end end
        local function remList(lst) for _,d in ipairs(lst) do tryRem(d) end end
        remList(obj.boxFull) remList(obj.boxCorner)
        remList(obj.outlineFull) remList(obj.outlineCorner)
        remList(obj.skel)
        tryRem(obj.fillQuad) tryRem(obj.hpBg) tryRem(obj.hpFill)
        tryRem(obj.name) tryRem(obj.dist) tryRem(obj.hdot) tryRem(obj.tracer)
        ESP.objs[pl]=nil
    end
    local hl=ESP.hl[pl]
    if hl then pcall(function() hl:Destroy() end) ESP.hl[pl]=nil end
end

function ESP.make(pl)
    if pl==LP then return end
    ESP.removeObj(pl)
    ESP.objs[pl]=ESP.newObj()
end

-- R15 names with R6 fallback so skeleton works on both rigs
function ESP.findPart(ch,names)
    for _,n in ipairs(names) do
        local p=ch:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
        local alt=U.R6[n]
        if alt then
            p=ch:FindFirstChild(alt)
            if p and p:IsA("BasePart") then return p end
        end
    end
    return nil
end

function ESP.boxOf(ch,obj)
    local root=ch:FindFirstChild("HumanoidRootPart") if not root then return nil end
    local cam=getCam() if not cam then return nil end
    if obj._boxChar~=ch or obj._boxSize~=root.Size then
        local head=ch:FindFirstChild("Head")
        local hum=ch:FindFirstChildOfClass("Humanoid")
        local hiY=1.6
        if head and head:IsA("BasePart") then
            local relHead=root.CFrame:PointToObjectSpace(head.Position)
            hiY=relHead.Y+head.Size.Y*0.5+0.12
        end
        local loY=-2.9
        if hum and hum.HipHeight then loY=-(hum.HipHeight+root.Size.Y*0.5+0.12) end
        for _,fn in ipairs({"LeftFoot","RightFoot","Left Leg","Right Leg","LeftLowerLeg","RightLowerLeg"}) do
            local foot=ch:FindFirstChild(fn)
            if foot and foot:IsA("BasePart") then
                local rel=root.CFrame:PointToObjectSpace(foot.Position)
                local fb=rel.Y-foot.Size.Y*0.5-0.05
                if fb<loY then loY=fb end
            end
        end
        local hw=root.Size.X*0.5+0.35
        local hd=root.Size.Z*0.5+0.35
        obj._boxOffsets={
            Vector3.new(-hw,loY,-hd),Vector3.new(hw,loY,-hd),
            Vector3.new(-hw,loY,hd),Vector3.new(hw,loY,hd),
            Vector3.new(-hw,hiY,-hd),Vector3.new(hw,hiY,-hd),
            Vector3.new(-hw,hiY,hd),Vector3.new(hw,hiY,hd),
        }
        obj._boxChar=ch obj._boxSize=root.Size
    end
    local offsets=obj._boxOffsets local rootCF=root.CFrame
    local mnX,mnY,mxX,mxY=math.huge,math.huge,-math.huge,-math.huge
    local anyOn=false
    for i=1,8 do
        local wp=(rootCF*CFrame.new(offsets[i])).Position
        local s=cam:WorldToViewportPoint(wp)
        if s.Z>0 then
            anyOn=true
            if s.X<mnX then mnX=s.X end if s.Y<mnY then mnY=s.Y end
            if s.X>mxX then mxX=s.X end if s.Y>mxY then mxY=s.Y end
        end
    end
    if not anyOn then return nil end
    if (mxX-mnX)<3 or (mxY-mnY)<3 then return nil end
    return mnX,mnY,mxX,mxY
end

function ESP.resolveCol(isT,isBl,customCol)
    if isBl then return Color3.fromRGB(255,60,60) end
    if C.espTeamCol and isT then return Color3.fromRGB(0,210,75) end
    return customCol
end

function ESP.setLine(l,from,to,color,thick)
    if not l then return end
    local vis=(from~=nil and to~=nil)
    if vis then
        if from and l.From~=from then l.From=from end
        if to and l.To~=to then l.To=to end
        if color and l.Color~=color then l.Color=color end
        if thick and l.Thickness~=thick then l.Thickness=thick end
    end
    if l.Visible~=vis then l.Visible=vis end
end

function ESP.setVis(d,v)
    if d and d.Visible~=v then d.Visible=v end
end

-- ── CHAMS (independent of ESP) ──
function ESP.disableChams(pl)
    local h=ESP.hl[pl]
    if h and h.Enabled then h.Enabled=false end
end

function ESP.applyChams(pl,ch,isT,isBl)
    local h=ESP.hl[pl]
    if not h or not h.Parent or h.Adornee~=ch then
        if h then pcall(function() h:Destroy() end) end
        h=Instance.new("Highlight")
        h.Name="HaesChams" h.Adornee=ch h.Parent=ch
        ESP.hl[pl]=h
    end
    if not h.Enabled then h.Enabled=true end
    local fill=C.chamsFillColor
    if isBl then fill=Color3.fromRGB(255,60,60)
    elseif isT and C.espTeamCol then fill=Color3.fromRGB(0,210,75) end
    if h.FillColor~=fill then h.FillColor=fill end
    local ft=C.chamsFill and 0.45 or 1
    if h.FillTransparency~=ft then h.FillTransparency=ft end
    if h.OutlineColor~=C.chamsOutlineColor then h.OutlineColor=C.chamsOutlineColor end
    local ot=C.chamsOutline and 0 or 1
    if h.OutlineTransparency~=ot then h.OutlineTransparency=ot end
    local dm=C.chamsOccluded and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    if h.DepthMode~=dm then h.DepthMode=dm end
end

function ESP.tickChams()
    if not C.chamsOn then
        if ESP.chamsWas then
            for _,h in pairs(ESP.hl) do if h and h.Enabled then h.Enabled=false end end
            ESP.chamsWas=false
        end
        return
    end
    ESP.chamsWas=true
    local cam=getCam() if not cam then return end
    local camPos=cam.CFrame.Position
    for _,pl in ipairs(PLRS:GetPlayers()) do
        if pl~=LP then
            local ch=pl.Character
            local hum=ch and ch:FindFirstChildOfClass("Humanoid")
            local root=ch and ch:FindFirstChild("HumanoidRootPart")
            local show=false local isT,isBl=false,false
            if ch and hum and root and hum.Health>0 then
                local wl,bl,team=U.info(pl,ch)
                isT,isBl=team,bl
                show=(not wl) and (not (C.espTeam and team and not bl))
                    and (root.Position-camPos).Magnitude<=C.espDist
            end
            if show then ESP.applyChams(pl,ch,isT,isBl) else ESP.disableChams(pl) end
        end
    end
end

-- boxes, names, hp, tracers, skeleton for one visible player
function ESP.draw(pl,obj,ch,hum,head,isT,isBl,camDist,mnX,mnY,mxX,mxY,vpX,vpY)
    local bW=mxX-mnX local bH=mxY-mnY
    local boxCol=ESP.resolveCol(isT,isBl,C.boxColor)
    local nameCol=ESP.resolveCol(isT,isBl,C.nameColor)
    local skelCol=ESP.resolveCol(isT,isBl,C.skeletonColor)
    local tracerCol=ESP.resolveCol(isT,isBl,C.tracerColor)
    local hdotCol=ESP.resolveCol(isT,isBl,C.headDotColor)
    local BLACK=Color3.fromRGB(0,0,0)
    local setLine,setVis=ESP.setLine,ESP.setVis

    -- Drawing.Transparency: 1 = opaque, 0 = invisible. fillBoxOpacity feeds it directly.
    if C.fillBoxOn then
        local fq=obj.fillQuad
        local pa=Vector2.new(mnX,mnY) local pb=Vector2.new(mxX,mnY)
        local pc=Vector2.new(mxX,mxY) local pd=Vector2.new(mnX,mxY)
        if fq.PointA~=pa then fq.PointA=pa end
        if fq.PointB~=pb then fq.PointB=pb end
        if fq.PointC~=pc then fq.PointC=pc end
        if fq.PointD~=pd then fq.PointD=pd end
        if fq.Color~=C.fillBoxColor then fq.Color=C.fillBoxColor end
        if fq.Transparency~=C.fillBoxOpacity then fq.Transparency=C.fillBoxOpacity end
        if not fq.Visible then fq.Visible=true end
    else setVis(obj.fillQuad,false) end

    if C.espOutline then
        if C.boxType=="Full" then
            local ol=obj.outlineFull
            setLine(ol[1],Vector2.new(mnX,mnY),Vector2.new(mxX,mnY),BLACK)
            setLine(ol[2],Vector2.new(mxX,mnY),Vector2.new(mxX,mxY),BLACK)
            setLine(ol[3],Vector2.new(mxX,mxY),Vector2.new(mnX,mxY),BLACK)
            setLine(ol[4],Vector2.new(mnX,mxY),Vector2.new(mnX,mnY),BLACK)
            for i=1,8 do setVis(obj.outlineCorner[i],false) end
        else
            local ol=obj.outlineCorner
            local fx,fy=bW*0.28,bH*0.28
            setLine(ol[1],Vector2.new(mnX,mnY),Vector2.new(mnX+fx,mnY),BLACK)
            setLine(ol[2],Vector2.new(mnX,mnY),Vector2.new(mnX,mnY+fy),BLACK)
            setLine(ol[3],Vector2.new(mxX,mnY),Vector2.new(mxX-fx,mnY),BLACK)
            setLine(ol[4],Vector2.new(mxX,mnY),Vector2.new(mxX,mnY+fy),BLACK)
            setLine(ol[5],Vector2.new(mnX,mxY),Vector2.new(mnX+fx,mxY),BLACK)
            setLine(ol[6],Vector2.new(mnX,mxY),Vector2.new(mnX,mxY-fy),BLACK)
            setLine(ol[7],Vector2.new(mxX,mxY),Vector2.new(mxX-fx,mxY),BLACK)
            setLine(ol[8],Vector2.new(mxX,mxY),Vector2.new(mxX,mxY-fy),BLACK)
            for i=1,4 do setVis(obj.outlineFull[i],false) end
        end
    else
        for i=1,4 do setVis(obj.outlineFull[i],false) end
        for i=1,8 do setVis(obj.outlineCorner[i],false) end
    end

    if C.boxOn then
        if C.boxType=="Full" then
            local bl=obj.boxFull
            setLine(bl[1],Vector2.new(mnX,mnY),Vector2.new(mxX,mnY),boxCol)
            setLine(bl[2],Vector2.new(mxX,mnY),Vector2.new(mxX,mxY),boxCol)
            setLine(bl[3],Vector2.new(mxX,mxY),Vector2.new(mnX,mxY),boxCol)
            setLine(bl[4],Vector2.new(mnX,mxY),Vector2.new(mnX,mnY),boxCol)
            for i=1,8 do setVis(obj.boxCorner[i],false) end
        else
            local bl=obj.boxCorner
            local fx,fy=bW*0.28,bH*0.28
            setLine(bl[1],Vector2.new(mnX,mnY),Vector2.new(mnX+fx,mnY),boxCol)
            setLine(bl[2],Vector2.new(mnX,mnY),Vector2.new(mnX,mnY+fy),boxCol)
            setLine(bl[3],Vector2.new(mxX,mnY),Vector2.new(mxX-fx,mnY),boxCol)
            setLine(bl[4],Vector2.new(mxX,mnY),Vector2.new(mxX,mnY+fy),boxCol)
            setLine(bl[5],Vector2.new(mnX,mxY),Vector2.new(mnX+fx,mxY),boxCol)
            setLine(bl[6],Vector2.new(mnX,mxY),Vector2.new(mnX,mxY-fy),boxCol)
            setLine(bl[7],Vector2.new(mxX,mxY),Vector2.new(mxX-fx,mxY),boxCol)
            setLine(bl[8],Vector2.new(mxX,mxY),Vector2.new(mxX,mxY-fy),boxCol)
            for i=1,4 do setVis(obj.boxFull[i],false) end
        end
    else
        for i=1,4 do setVis(obj.boxFull[i],false) end
        for i=1,8 do setVis(obj.boxCorner[i],false) end
    end

    if C.espHpBar then
        local maxHp=math.max(hum.MaxHealth,1)
        local hp=math.clamp(hum.Health/maxHp,0,1)
        local bx=mnX-5
        local bgFrom=Vector2.new(bx,mnY) local bgTo=Vector2.new(bx,mxY)
        if obj.hpBg.From~=bgFrom then obj.hpBg.From=bgFrom end
        if obj.hpBg.To~=bgTo then obj.hpBg.To=bgTo end
        if not obj.hpBg.Visible then obj.hpBg.Visible=true end
        local fillTop=mxY-bH*hp
        local hpCol=Color3.fromRGB(math.floor((1-hp)*255),math.floor(hp*220),40)
        local fillFrom=Vector2.new(bx,mxY) local fillTo=Vector2.new(bx,fillTop)
        if obj.hpFill.From~=fillFrom then obj.hpFill.From=fillFrom end
        if obj.hpFill.To~=fillTo then obj.hpFill.To=fillTo end
        if obj.hpFill.Color~=hpCol then obj.hpFill.Color=hpCol end
        if not obj.hpFill.Visible then obj.hpFill.Visible=true end
    else
        setVis(obj.hpBg,false) setVis(obj.hpFill,false)
    end

    if C.nameOn then
        local ntxt=C.nameType=="Display Name" and (pl.DisplayName~="" and pl.DisplayName or pl.Name) or pl.Name
        local npos=Vector2.new((mnX+mxX)*0.5,mnY-14)
        if obj.name.Text~=ntxt then obj.name.Text=ntxt end
        if obj.name.Position~=npos then obj.name.Position=npos end
        if obj.name.Color~=nameCol then obj.name.Color=nameCol end
        if not obj.name.Visible then obj.name.Visible=true end
    else setVis(obj.name,false) end

    if C.showDist then
        local dpos=Vector2.new((mnX+mxX)*0.5,mxY+3)
        local dtext=string.format("[%.0f]",camDist)
        if obj.dist.Text~=dtext then obj.dist.Text=dtext end
        if obj.dist.Position~=dpos then obj.dist.Position=dpos end
        if not obj.dist.Visible then obj.dist.Visible=true end
    else setVis(obj.dist,false) end

    if C.showDot and head then
        local hs,hon=U.w2v(head.Position)
        if hon then
            if obj.hdot.Position~=hs then obj.hdot.Position=hs end
            if obj.hdot.Color~=hdotCol then obj.hdot.Color=hdotCol end
            if not obj.hdot.Visible then obj.hdot.Visible=true end
        else setVis(obj.hdot,false) end
    else setVis(obj.hdot,false) end

    if C.tracerOn then
        local from
        if C.tracerOrig=="Top" then from=Vector2.new(vpX*0.5,0)
        elseif C.tracerOrig=="Middle" then from=Vector2.new(vpX*0.5,vpY*0.5)
        elseif C.tracerOrig=="Mouse" then from=Vector2.new(mouse.aim.X,mouse.aim.Y)
        else from=Vector2.new(vpX*0.5,vpY) end
        local to=Vector2.new((mnX+mxX)*0.5,mxY)
        if obj.tracer.From~=from then obj.tracer.From=from end
        if obj.tracer.To~=to then obj.tracer.To=to end
        if obj.tracer.Color~=tracerCol then obj.tracer.Color=tracerCol end
        if not obj.tracer.Visible then obj.tracer.Visible=true end
    else setVis(obj.tracer,false) end

    if C.showSkel then
        -- rebuild the bone map when the character changes or any part was missing last build
        if ST.frame%ESP.skelInt==0 and (obj._boneChar~=ch or obj._boneMiss) then
            local bones,miss={},false
            for i,pair in ipairs(ESP.BONES) do
                local a=ESP.findPart(ch,pair[1])
                local b=ESP.findPart(ch,pair[2])
                if not a or not b then miss=true end
                bones[i]={a,b}
            end
            obj._bones=bones obj._boneChar=ch obj._boneMiss=miss
        end
        local bones=obj._bones or {}
        for i=1,ESP.MAX_BONES do
            local b=bones[i]
            local pA=b and b[1] local pB=b and b[2]
            if pA and pB then
                local sA,onA=U.w2v(pA.Position)
                local sB,onB=U.w2v(pB.Position)
                if onA or onB then
                    if obj.skel[i].From~=sA then obj.skel[i].From=sA end
                    if obj.skel[i].To~=sB then obj.skel[i].To=sB end
                    if obj.skel[i].Color~=skelCol then obj.skel[i].Color=skelCol end
                    if not obj.skel[i].Visible then obj.skel[i].Visible=true end
                else setVis(obj.skel[i],false) end
            else setVis(obj.skel[i],false) end
        end
    else
        for i=1,ESP.MAX_BONES do setVis(obj.skel[i],false) end
    end
end

function ESP.tick()
    if not isActive("esp") then
        if ESP.wasEnabled then
            for _,obj in pairs(ESP.objs) do
                if obj._vis then ESP.hide(obj) obj._vis=false end
            end
            ESP.wasEnabled=false
        end
        return
    end
    ESP.wasEnabled=true
    local cam=getCam() if not cam then return end
    local camPos=cam.CFrame.Position
    local vp=cam.ViewportSize

    -- self ESP needs its own object, make() skips LocalPlayer
    if C.espSelf and not ESP.objs[LP] then ESP.objs[LP]=ESP.newObj() end

    for pl,obj in pairs(ESP.objs) do
        local okP,errP=pcall(ESP.tickOne,pl,obj,camPos,vp)
        if not okP and not ERR_SEEN["ESP_PLR"] then
            ERR_SEEN["ESP_PLR"]=true
            warn("[Haes] ESP player "..tostring(pl and pl.Name)..": "..tostring(errP))
        end
    end
end

function ESP.tickOne(pl,obj,camPos,vp)
        local ch=pl.Character
        local hum=ch and ch:FindFirstChildOfClass("Humanoid")
        local root=ch and ch:FindFirstChild("HumanoidRootPart")
        local head=ch and ch:FindFirstChild("Head")
        local show,isT,isBl,camDist=false,false,false,0

        if ch and hum and root and (hum.Health or 0)>0 and (C.espSelf or pl~=LP) then
            local wl,bl,team=U.info(pl,ch)
            isT,isBl=team,bl
            camDist=(root.Position-camPos).Magnitude
            if not wl and not (C.espTeam and team and not bl and pl~=LP) and camDist<=(tonumber(C.espDist) or 2500) then
                if C.espWall and pl~=LP then
                    if ST.frame-obj._wallFrame>=6 then
                        obj._wallFrame=ST.frame
                        obj._wallVisible=U.rayWall(ch,head or root)
                    end
                    show=obj._wallVisible
                else
                    show=true
                end
            end
        end

        local mnX,mnY,mxX,mxY
        if show then mnX,mnY,mxX,mxY=ESP.boxOf(ch,obj) end
        if mnX then
            obj._vis=true
            ESP.draw(pl,obj,ch,hum,head,isT,isBl,camDist,mnX,mnY,mxX,mxY,vp.X,vp.Y)
        elseif obj._vis then
            ESP.hide(obj) obj._vis=false
        end
end

