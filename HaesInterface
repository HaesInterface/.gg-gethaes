function PC.refresh()
    local myTeam=LP.Team local checks=TM.localSig()
    for _,plr in ipairs(PLRS:GetPlayers()) do
        if plr~=LP then
            local c=PC.cache[plr]
            if not c then c={} PC.cache[plr]=c end
            local isT=false
            if myTeam~=nil and plr.Team~=nil and myTeam==plr.Team then isT=true
            elseif #checks>0 then isT=TM.matches(plr,checks) end
            c.isTeam=isT
            local uid=tostring(plr.UserId)
            c.isWL=(C.whitelist[uid]~=nil or C.whitelist[plr.Name]~=nil)
