    end
end

function CAM.stopAll()
    if CAM.specConn then CAM.specConn:Disconnect() CAM.specConn=nil end
    if CAM.aimConn then CAM.aimConn:Disconnect() CAM.aimConn=nil end
    CAM.specTarget=nil CAM.aimTarget=nil CAM.owned=false
    AIM.reset()
    CAM.restore()
end

function CAM.spectate(p)
    if CAM.specTarget==p then CAM.stopAll() return end
    CAM.stopAll()
    if not p or not p.Character then return end
    local hum=p.Character:FindFirstChildOfClass("Humanoid") if not hum then return end
    CAM.specTarget=p CAM.owned=true
    local cam=getCam()
    if cam then cam.CameraType=Enum.CameraType.Custom cam.CameraSubject=hum end
    CAM.specConn=RUN.Heartbeat:Connect(function()
        if not CAM.specTarget then return end
        if not CAM.specTarget.Character or not CAM.specTarget.Character:FindFirstChildOfClass("Humanoid") then
            CAM.stopAll()
        end
    end)
end

function CAM.aimView(p)
    if CAM.aimTarget==p then CAM.stopAll() return end
    CAM.stopAll()
    if not p or not p.Character then return end
    CAM.aimTarget=p CAM.owned=true
    local cam=getCam() if cam then cam.CameraType=Enum.CameraType.Scriptable end
    CAM.aimConn=RUN.RenderStepped:Connect(function()
        local t=CAM.aimTarget
        if not t or not t.Character then CAM.stopAll() return end
        local head=t.Character:FindFirstChild("Head")
        if not head then return end
        local cam2=getCam() if not cam2 then return end
        local behind=head.CFrame.LookVector*-5.5
        local eye=head.Position+Vector3.new(0,1.2,0)+behind
        local lookAt=head.Position+head.CFrame.LookVector*40
        cam2.CFrame=CFrame.lookAt(eye,lookAt)
    end)
end

function CAM.teleport(p)
    if not p or not p.Character then return end
    local myRoot=getRoot()
    local tRoot=p.Character:FindFirstChild("HumanoidRootPart")
    if myRoot and tRoot then myRoot.CFrame=tRoot.CFrame*CFrame.new(0,0,3) end
end

-- ═══════════════════════════════════════════════════════════
--  TRIGGERBOT
-- ═══════════════════════════════════════════════════════════
TB.lastFire=0 TB.mtbLast=0

function TB.fire(holdMs)
    holdMs=math.max(holdMs or 30,1)
    if type(mouse1press)=="function" and type(mouse1release)=="function" then
        pcall(mouse1press)
        task.delay(holdMs/1000,function() pcall(mouse1release) end)
        return
    end
    if type(mouse1click)=="function" then pcall(mouse1click) return end
    pcall(function()
        local vim=game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(mouse.aim.X,mouse.aim.Y,0,true,game,1)
        task.delay(holdMs/1000,function()
            pcall(function() vim:SendMouseButtonEvent(mouse.aim.X,mouse.aim.Y,0,false,game,1) end)
        end)
    end)
end

-- raycast from screen centre; falls back to mouse target when cursor is free
function TB.findTarget()
    local cam=getCam() if not cam then return nil,nil,nil end
    local origin=cam.CFrame.Position
    local result=WS:Raycast(origin,cam.CFrame.LookVector*2500,U.rayExclude(nil))

    local function plrFromModel(inst)
        if not inst then return nil,nil,nil end
        local m=inst:FindFirstAncestorOfClass("Model")
        while m do
            local pl=PLRS:GetPlayerFromCharacter(m)
            if pl and pl~=LP then return m,pl,inst end
            m=m:FindFirstAncestorOfClass("Model")
        end
        return nil,nil,nil
    end

    if result then
        local ch,pl,hp=plrFromModel(result.Instance)
        if pl then return ch,pl,hp end
    end
    if UIS.MouseBehavior~=Enum.MouseBehavior.LockCenter then
        local mt=mouse.aim.Target
        if mt then
            local ch,pl,hp=plrFromModel(mt)
            if pl then return ch,pl,hp end
        end
    end
    return nil,nil,nil
end

function TB.tick()
    if not isActive("tb") then return end
    local char=LP.Character if not char then return end
    local tool=char:FindFirstChildWhichIsA("Tool")
    if not tool or tool.Enabled==false then return end
    if C.tbKnifeCheck and U.isMelee(tool) then return end

    local now=os.clock()
    local delay=math.max(C.tbDelay,0)/1000
    local rel=math.max(C.tbRel,1)/1000
    if now-TB.lastFire<delay+rel then return end

    local tch,plr,hitPart=TB.findTarget()
    if not tch or not plr then return end
    if not U.validEnemy(plr,tch,C.tbTeam,C.tbKnock,C.tbWall,hitPart) then return end

    TB.lastFire=now
    if delay>0.001 then
        task.delay(delay,function()
            if not isActive("tb") then return end
            local c2,p2,h2=TB.findTarget()
            if c2==tch and p2==plr and U.validEnemy(plr,c2,C.tbTeam,C.tbKnock,C.tbWall,h2) then
                TB.fire(C.tbRel)
            end
        end)
    else
        TB.fire(C.tbRel)
    end
end

-- fires only while aim assist holds a target and the crosshair is on it
function TB.tickMagnetic()
    if not C.mtbOn then return end
    if not isActive("aa") then return end
    local t=AIM.active
    if not t or not t.plr then return end

    local char=LP.Character if not char then return end
    local tool=char:FindFirstChildWhichIsA("Tool")
    if not tool or tool.Enabled==false then return end
    if C.mtbKnifeCheck and U.isMelee(tool) then return end

    local now=os.clock()
    local delay=math.max(C.mtbDelay,0)/1000
    local rel=math.max(C.mtbRel,1)/1000
    if now-TB.mtbLast<delay+rel then return end

    local tch=t.plr.Character if not tch then return end
    if not U.validEnemy(t.plr,tch,C.aaTeam,C.aaKnock,C.aaWall,t.part) then return end

    local part=U.resolvePart(tch,C.aaPart) if not part then return end
    local cam=getCam() if not cam then return end
    local camPos=cam.CFrame.Position
    local toDist=(part.Position-camPos).Magnitude
    if toDist>C.aaDist then return end

    -- tighter cone the closer the target
    local tn=math.clamp((toDist-10)/(500-10),0,1)
    local ts=tn*tn*(3.0-2.0*tn)
    local dotThresh=0.985+(0.9985-0.985)*ts

    local toDir=part.Position-camPos
    if toDir.Magnitude<1e-4 then return end
    toDir=toDir.Unit
    if cam.CFrame.LookVector:Dot(toDir)<dotThresh then return end

    local sp,on=U.w2v(part.Position)
    if not on then return end
    local vp=cam.ViewportSize
    if (sp-Vector2.new(vp.X*0.5,vp.Y*0.5)).Magnitude>20 then return end

    TB.mtbLast=now
    local plr=t.plr
    if delay>0.001 then
        task.delay(delay,function()
            if not (C.mtbOn and isActive("aa")) then return end
            local cur=AIM.active
            if not cur or cur.plr~=plr then return end
            if U.validEnemy(plr,tch,C.aaTeam,C.aaKnock,C.aaWall,cur.part) then
                TB.fire(C.mtbRel)
            end
        end)
    else
        TB.fire(C.mtbRel)
    end
end

