    local function updateLcInfo(r)
        if not r or not r.valid then return end
        local tierColors={PERMANENT=Color3.fromRGB(50,200,100),MONTHLY=Color3.fromRGB(80,150,255),WEEKLY=Color3.fromRGB(210,170,60),DAILY=Color3.fromRGB(210,110,60)}
        if lcStatusLbl then lcStatusLbl.Text="Active License" lcStatusLbl.TextColor3=tierColors[r.tier] or Color3.fromRGB(240,240,245) end
        if lcValidLbl then lcValidLbl.Text=(r.expiresAt and r.expiresAt>0) and("Valid Until "..formatDate(r.expiresAt)) or "Permanent License" end
        if lcTimeValue then lcTimeValue.Text=(r.remaining==-1) and "∞" or(r.label or "—") end
    end

    local function launchMain(r,skipAnim)
        if mainShown then return end
        mainShown=true
        if skipAnim then
            if licenceScreen then licenceScreen.Visible=false end
            main.Visible=true updateLcInfo(r)
            task.defer(function() switchPage("Combat") end)
            return
        end
        task.spawn(function()
            if licenceScreen then
                TWEEN:Create(licenceScreen,TweenInfo.new(0.15,Enum.EasingStyle.Quint,Enum.EasingDirection.In),{BackgroundTransparency=1}):Play()
                task.wait(0.15)
                licenceScreen.Visible=false
            end
            main.Visible=true updateLcInfo(r)
            task.defer(function() switchPage("Combat") end)
        end)
    end

    if logoutBtnRef then
        logoutBtnRef.MouseButton1Click:Connect(function()
            mainShown=false main.Visible=false
            if type(writefile)=="function" then pcall(writefile,LICENCE_FILE,"") end
            if licenceScreen then licenceScreen.Visible=true licenceScreen.BackgroundTransparency=1 end
        end)
    end

    licenceScreen=Instance.new("Frame",gui)
    licenceScreen.Size=UDim2.new(1,0,1,0) licenceScreen.BackgroundTransparency=1
    licenceScreen.BorderSizePixel=0 licenceScreen.ZIndex=1000

    local lcBox=Instance.new("Frame",licenceScreen)
    lcBox.Size=UDim2.new(0,320,0,240) lcBox.AnchorPoint=Vector2.new(0.5,0.5) lcBox.Position=UDim2.new(0.5,0,0.5,0)
    lcBox.BackgroundColor3=Color3.fromRGB(13,13,15) lcBox.BorderSizePixel=0 lcBox.ZIndex=1001
    Instance.new("UICorner",lcBox).CornerRadius=UDim.new(0,10)
    local lcStroke=Instance.new("UIStroke",lcBox)
    lcStroke.Color=ACC() lcStroke.Thickness=1 lcStroke.Transparency=0.4
    task.spawn(function()
        while licenceScreen and licenceScreen.Parent do
            TWEEN:Create(lcStroke,TweenInfo.new(1.6,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Transparency=0.1}):Play()
            task.wait(1.6)
            TWEEN:Create(lcStroke,TweenInfo.new(1.6,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Transparency=0.7}):Play()
            task.wait(1.6)
        end
    end)
    regT(lcStroke,"Color")

    local lcTitle=Instance.new("TextLabel",lcBox)
    lcTitle.Size=UDim2.new(1,-28,0,18) lcTitle.Position=UDim2.new(0,14,0,14)
    lcTitle.BackgroundTransparency=1 lcTitle.Text="Haes Interface"
    lcTitle.TextColor3=ACC() lcTitle.Font=Enum.Font.GothamBold lcTitle.TextSize=13
    lcTitle.TextXAlignment=Enum.TextXAlignment.Left lcTitle.ZIndex=1002
    regT(lcTitle,"TextColor3")

    local lcSub=Instance.new("TextLabel",lcBox)
    lcSub.Size=UDim2.new(1,-28,0,12) lcSub.Position=UDim2.new(0,14,0,38)
    lcSub.BackgroundTransparency=1 lcSub.Text="ACTIVATION REQUIRED"
    lcSub.TextColor3=Color3.fromRGB(100,100,110) lcSub.Font=Enum.Font.GothamSemibold lcSub.TextSize=9
    lcSub.TextXAlignment=Enum.TextXAlignment.Left lcSub.ZIndex=1002

    local lcDiv=Instance.new("Frame",lcBox)
    lcDiv.Size=UDim2.new(1,-28,0,1) lcDiv.Position=UDim2.new(0,14,0,58)
    lcDiv.BackgroundColor3=Color3.fromRGB(30,30,36) lcDiv.BorderSizePixel=0 lcDiv.ZIndex=1002

    local lcInput=Instance.new("TextBox",lcBox)
    lcInput.Size=UDim2.new(1,-28,0,36) lcInput.Position=UDim2.new(0,14,0,76)
    lcInput.BackgroundColor3=Color3.fromRGB(20,20,24) lcInput.BorderSizePixel=0
    lcInput.Text="" lcInput.PlaceholderText="HAES-XXXX-XXXXXXXX"
    lcInput.PlaceholderColor3=Color3.fromRGB(80,80,90) lcInput.TextColor3=Color3.fromRGB(240,240,245)
    lcInput.Font=Enum.Font.GothamSemibold lcInput.TextSize=11 lcInput.ZIndex=1002 lcInput.ClearTextOnFocus=false
    Instance.new("UICorner",lcInput).CornerRadius=UDim.new(0,6)
    local lcIS=Instance.new("UIStroke",lcInput) lcIS.Color=Color3.fromRGB(36,36,44)
    Instance.new("UIPadding",lcInput).PaddingLeft=UDim.new(0,10)
    lcInput.Focused:Connect(function() lcIS.Color=ACC() end)
    lcInput.FocusLost:Connect(function() lcIS.Color=Color3.fromRGB(36,36,44) end)

    local lcBtn=Instance.new("TextButton",lcBox)
    lcBtn.Size=UDim2.new(1,-28,0,36) lcBtn.Position=UDim2.new(0,14,0,122)
    lcBtn.BackgroundColor3=ACC() lcBtn.BorderSizePixel=0 lcBtn.Text="ACTIVATE"
    lcBtn.TextColor3=Color3.new(1,1,1) lcBtn.Font=Enum.Font.GothamBold lcBtn.TextSize=11
    lcBtn.ZIndex=1002 lcBtn.AutoButtonColor=false
    Instance.new("UICorner",lcBtn).CornerRadius=UDim.new(0,6)
    regT(lcBtn,"BackgroundColor3")

    local lcStatus=Instance.new("TextLabel",lcBox)
    lcStatus.Size=UDim2.new(1,-28,0,16) lcStatus.Position=UDim2.new(0,14,0,166)
    lcStatus.BackgroundTransparency=1 lcStatus.Text=""
    lcStatus.TextColor3=Color3.fromRGB(100,100,110) lcStatus.Font=Enum.Font.Gotham lcStatus.TextSize=9
    lcStatus.TextXAlignment=Enum.TextXAlignment.Center lcStatus.ZIndex=1002

    local lcAttr=Instance.new("TextLabel",lcBox)
    lcAttr.Size=UDim2.new(1,-28,0,12) lcAttr.Position=UDim2.new(0,14,1,-20)
    lcAttr.BackgroundTransparency=1 lcAttr.Text="Built by Haes"
    lcAttr.TextColor3=Color3.fromRGB(60,60,70) lcAttr.Font=Enum.Font.Gotham lcAttr.TextSize=8
    lcAttr.TextXAlignment=Enum.TextXAlignment.Center lcAttr.ZIndex=1002

    local function doActivate()
        local key=lcInput.Text:upper():gsub("%s+","")
        if key=="" then lcStatus.Text="enter a key" lcStatus.TextColor3=TDIM return end
        lcStatus.Text="verifying..." lcStatus.TextColor3=TDIM
        local r=validateKey(key)
        if r.valid then
            lcStatus.Text="✓ access granted" lcStatus.TextColor3=Color3.fromRGB(50,200,100)
            task.delay(0.8,function() launchMain(r) end)
        else
            lcStatus.Text="✗ "..(r.label or "invalid key") lcStatus.TextColor3=Color3.fromRGB(220,60,60)
            local function sh(dx,delay)
                task.delay(delay,function()
                    if lcBox and lcBox.Parent then lcBox.Position=UDim2.new(0.5,dx,0.5,0) end
                end)
            end
            sh(-8,0) sh(8,0.06) sh(-6,0.12) sh(6,0.18) sh(0,0.24)
        end
    end
    lcBtn.MouseButton1Click:Connect(doActivate)
    lcInput.FocusLost:Connect(function(enter) if enter then doActivate() end end)

    local function trySavedKey()
        if type(readfile)~="function" then return false end
        local d=readJson(LICENCE_FILE) if not d or not d.key then return false end
        local r=validateKey(d.key)
        if r.valid then return r end
        if type(writefile)=="function" then pcall(writefile,LICENCE_FILE,"") end
        return false
    end

    print("[Haes] stage 5: licence built")

    local saved=trySavedKey()
    if saved then task.defer(function() launchMain(saved,true) end) end

    task.defer(function()
        if C.autoLoadOn and C.autoLoadName~="" and Configs[C.autoLoadName] then
            applyConfig(Configs[C.autoLoadName])
        end
        local us=main:FindFirstChildOfClass("UIScale")
        if not us then us=Instance.new("UIScale",main) end
        us.Scale=C.uiScale/100
    end)

    task.delay(0.5,function()
        if not mainShown and licenceScreen then licenceScreen.Visible=true end
    end)
end

