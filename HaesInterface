        if i.UserInputType==Enum.UserInputType.MouseButton1 then dragOn=false end
    end))
    track(UIS.InputChanged:Connect(function(i)
        if not(dragOn and dragStart and i.UserInputType==Enum.UserInputType.MouseMovement) then return end
        local d=i.Position-dragStart
        main.Position=UDim2.new(dragOrig.X.Scale,dragOrig.X.Offset+d.X,dragOrig.Y.Scale,dragOrig.Y.Offset+d.Y)
    end))

    track(UIS.InputBegan:Connect(function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
        local mp=input.Position
        local function inside(f)
            if not f.Visible then return false end
            local ap=f.AbsolutePosition local as=f.AbsoluteSize
            return mp.X>=ap.X and mp.X<=ap.X+as.X and mp.Y>=ap.Y and mp.Y<=ap.Y+as.Y
        end
        if not inside(ddFrame) and(not curDDBtn or not inside(curDDBtn)) then closeDD() end
        if not inside(bindMenu) then closeBindMenu() end
    end))

    local function getMenuKeyEnum()
        local ok,e=pcall(function() return Enum.KeyCode[C.menuKey] end)
        if ok and e then return e end
        return Enum.KeyCode.RightShift
    end

    local allFeatures={"aa","sa","tb","flyOn","speedOn","jumpOn","infiniteJumpOn","noclipOn"}

    track(UIS.InputBegan:Connect(function(input,gpe)
        local listen=BIND.listening
        if listen then
            if input.UserInputType==Enum.UserInputType.Keyboard then
                local kn=input.KeyCode.Name
                if kn~="Unknown" then
                    if listen=="menuKey" then
                        C.menuKey=kn
                        if UI_Update["menuKey"] then UI_Update["menuKey"](kn) end
                    else
                        if kn==C.menuKey then showNotif("Cannot bind feature to menu key",Color3.fromRGB(220,60,60))
                        else addKey(listen,{type="key",value=kn}) end
                    end
                    BIND.listening=nil
                    if BIND.cb[listen] then pcall(BIND.cb[listen]) end
                    return
                end
            elseif input.UserInputType==Enum.UserInputType.MouseButton1 and not gpe and listen~="menuKey" then
                addKey(listen,{type="mouse",value="Button1"})
                BIND.listening=nil
                if BIND.cb[listen] then pcall(BIND.cb[listen]) end
                return
            elseif input.UserInputType==Enum.UserInputType.MouseButton2 and not gpe and listen~="menuKey" then
                addKey(listen,{type="mouse",value="Button2"})
                BIND.listening=nil
                if BIND.cb[listen] then pcall(BIND.cb[listen]) end
                return
            end
            return
        end
        if input.UserInputType==Enum.UserInputType.Keyboard and not gpe
            and not UIS:GetFocusedTextBox()
            and input.KeyCode==getMenuKeyEnum() then
            main.Visible=not main.Visible
            return
        end
        if gpe or UIS:GetFocusedTextBox() then return end
        for _,feat in ipairs(allFeatures) do
            if BIND.keyMatch(C.binds[feat],input) then BIND.down(feat) end
        end
    end))

    track(UIS.InputEnded:Connect(function(input)
        if BIND.listening then return end
        for _,feat in ipairs(allFeatures) do
            if BIND.keyMatch(C.binds[feat],input) then BIND.up(feat) end
        end
    end))

