        table.insert(themeReg,{obj=pillProxy,prop="x"})

        local lbl=Instance.new("TextLabel",row)
        lbl.AnchorPoint=Vector2.new(0,0.5) lbl.Position=UDim2.new(0,2,0.5,note and -6 or 0)
        lbl.Size=UDim2.new(1,feat and -140 or -40,0,14)
        lbl.BackgroundTransparency=1 lbl.Text=text lbl.TextColor3=state and TCOL or TDIM
        lbl.Font=Enum.Font.GothamSemibold lbl.TextSize=10 lbl.TextXAlignment=Enum.TextXAlignment.Left lbl.ZIndex=5
        if note then
            local nl=Instance.new("TextLabel",row)
            nl.AnchorPoint=Vector2.new(0,0) nl.Position=UDim2.new(0,2,0.5,5)
            nl.Size=UDim2.new(1,feat and -140 or -40,0,10)
            nl.BackgroundTransparency=1 nl.Text=note nl.TextColor3=TDIM2
            nl.Font=Enum.Font.Gotham nl.TextSize=8 nl.TextXAlignment=Enum.TextXAlignment.Left nl.ZIndex=5
        end
        if feat then makeKeybindBadge(row,feat) end
        local btn=Instance.new("TextButton",row)
        btn.Size=UDim2.new(1,0,1,0) btn.BackgroundTransparency=1 btn.Text="" btn.ZIndex=9 btn.AutoButtonColor=false

        if feat then C.toggled[feat]=state end
        pillProxy.update()

        local function upd(s)
            if s~=nil then state=s end
            if feat then
                C.toggled[feat]=state
                if not state then C._state[feat]=false end
            end
            pillProxy.update()
            TWEEN:Create(thumb,TweenInfo.new(0.12,Enum.EasingStyle.Quint),
                {Position=state and UDim2.new(1,-6,0.5,0) or UDim2.new(0,6,0.5,0)}):Play()
            lbl.TextColor3=state and TCOL or TDIM
        end

        if configKey then UI_Update[configKey]=function(v) upd(v) end end

        btn.MouseButton1Click:Connect(function()
            state=not state
            upd()
            if feat then
                if not state then
                    C._state[feat]=false if cb then pcall(cb,false) end
                else
                    local mode=BIND.mode(feat)
                    if mode=="Always" or mode=="Toggle" then
                        C._state[feat]=true if cb then pcall(cb,true) end
                    elseif mode=="Hold" and(C.binds[feat] and C.binds[feat].holdAt=="Off") then
                        C._state[feat]=true if cb then pcall(cb,true) end
                    end
                end
            else
                if cb then pcall(cb,state) end
            end
        end)

        if feat then
            BIND.toggleUp[feat]=function()
                local currentState=C.toggled[feat]==true
                if state~=currentState then upd(currentState) end
            end
            if cb then BIND.feat[feat]=cb end
        end

        return function(v)
            upd(v)
            if cb then pcall(cb,v) end
        end
    end

    local function addSliderItem(parent,text,mn,mx,init,cb,fmt,configKey)
        local row=Instance.new("Frame",parent)
        row.BackgroundTransparency=1 row.Size=UDim2.new(1,0,0,44) row.ZIndex=4
        local lbl=Instance.new("TextLabel",row)
        lbl.Size=UDim2.new(0.55,0,0,14) lbl.Position=UDim2.new(0,2,0,0)
        lbl.BackgroundTransparency=1 lbl.Text=text lbl.TextColor3=TDIM
        lbl.Font=Enum.Font.Gotham lbl.TextSize=9 lbl.TextXAlignment=Enum.TextXAlignment.Left lbl.ZIndex=5

        local isFloat=(fmt~=nil)
        local decPlaces=0
        if isFloat then
            local dp=fmt:match("%%%.(%d+)f")
            decPlaces=tonumber(dp) or 2
        end
        local precMult=10^decPlaces

        local vbW=(decPlaces>=4) and 68 or (isFloat and 52 or 48)
        local valBox=Instance.new("TextBox",row)
        valBox.Size=UDim2.new(0,vbW,0,16) valBox.Position=UDim2.new(1,-vbW-2,0,0)
        valBox.BackgroundColor3=BG4 valBox.BorderSizePixel=0
        valBox.TextColor3=ACC() valBox.Font=Enum.Font.GothamSemibold valBox.TextSize=10
        valBox.TextXAlignment=Enum.TextXAlignment.Center valBox.ZIndex=6 valBox.ClearTextOnFocus=false
        Instance.new("UICorner",valBox).CornerRadius=UDim.new(0,4)
        local vs=Instance.new("UIStroke",valBox) vs.Color=BORDER
        regT(valBox,"TextColor3")

        local function canonVal(v)
            v=math.clamp(v,mn,mx)
            if isFloat then return math.floor(v*precMult+0.5)/precMult end
            return math.floor(v+0.5)
        end
        local function dispStr(v)
            if isFloat then return string.format(fmt,v) end
            return tostring(math.floor(v+0.5))
        end

        local curVal=canonVal(init)
        valBox.Text=dispStr(curVal)

        local trkBg=Instance.new("Frame",row)
        trkBg.Size=UDim2.new(1,-4,0,3) trkBg.Position=UDim2.new(0,2,0,28)
        trkBg.BackgroundColor3=Color3.fromRGB(28,28,36) trkBg.BorderSizePixel=0 trkBg.ZIndex=5
        Instance.new("UICorner",trkBg).CornerRadius=UDim.new(1,0)
        local fill=Instance.new("Frame",trkBg)
        fill.Size=UDim2.new(math.clamp((curVal-mn)/(mx-mn),0,1),0,1,0)
        fill.BackgroundColor3=ACC() fill.BorderSizePixel=0 fill.ZIndex=6
        Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
        regT(fill,"BackgroundColor3")
        local thm=Instance.new("Frame",trkBg)
        thm.Size=UDim2.new(0,10,0,10) thm.AnchorPoint=Vector2.new(0.5,0.5)
        thm.Position=UDim2.new(math.clamp((curVal-mn)/(mx-mn),0,1),0,0.5,0)
        thm.BackgroundColor3=Color3.new(1,1,1) thm.BorderSizePixel=0 thm.ZIndex=7
        Instance.new("UICorner",thm).CornerRadius=UDim.new(1,0)
        local ts=Instance.new("UIStroke",thm) ts.Color=ACC()
        regT(ts,"Color")
        local trackBtn=Instance.new("TextButton",row)
        trackBtn.Size=UDim2.new(1,-4,0,18) trackBtn.Position=UDim2.new(0,2,0,22)
        trackBtn.BackgroundTransparency=1 trackBtn.Text="" trackBtn.ZIndex=8 trackBtn.AutoButtonColor=false

        local function applyVal(val)
            val=canonVal(val)
            curVal=val
            local pct=math.clamp((val-mn)/(mx-mn),0,1)
            fill.Size=UDim2.new(pct,0,1,0)
            thm.Position=UDim2.new(pct,0,0.5,0)
            valBox.Text=dispStr(val)
            if cb then pcall(cb,val) end
        end

        if configKey then UI_Update[configKey]=function(v) applyVal(v) end end

        local function fromMouse(sx)
            local sz=trackBtn.AbsoluteSize.X
            if sz<=0 then return end
            local pct=math.clamp((sx-trackBtn.AbsolutePosition.X)/sz,0,1)
            applyVal(mn+(mx-mn)*pct)
        end

        valBox.Focused:Connect(function() vs.Color=ACC() end)
        valBox.FocusLost:Connect(function()
            vs.Color=BORDER
            local num=tonumber(valBox.Text)
            if num then applyVal(num) else valBox.Text=dispStr(curVal) end
        end)

        trackBtn.MouseButton1Down:Connect(function()
            fromMouse(mouse.aim.X)
            local dragging=true
            local c1,c2
            c1=UIS.InputChanged:Connect(function(inp)
                if not dragging then return end
                if inp.UserInputType==Enum.UserInputType.MouseMovement then fromMouse(inp.Position.X) end
            end)
            c2=UIS.InputEnded:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                    dragging=false
                    if c1 then c1:Disconnect() end
                    if c2 then c2:Disconnect() end
                end
            end)
        end)
        return row
    end

