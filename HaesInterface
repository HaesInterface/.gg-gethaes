-- true when the line of sight to part is clear
function U.rayWall(char,part)
    if not char or not part then return false end
    local cam=getCam() if not cam then return false end
    local origin=cam.CFrame.Position
    local result=WS:Raycast(origin,part.Position-origin,U.rayExclude(char))
    return result==nil
end

function U.w2v(pos)
    local cam=getCam() if not cam then return Vector2.zero,false,0 end
    local s,on=cam:WorldToViewportPoint(pos)
    return Vector2.new(s.X,s.Y),(on and s.Z>0),s.Z
end

-- R15 name → R6 fallback, then Head, then HumanoidRootPart
function U.resolvePart(ch,name)
    if not ch then return nil end
    local p=name and ch:FindFirstChild(name)
    if p and p:IsA("BasePart") then return p end
    local alt=name and U.R6[name]
    if alt then
        p=ch:FindFirstChild(alt)
        if p and p:IsA("BasePart") then return p end
    end
    p=ch:FindFirstChild("Head")
    if p and p:IsA("BasePart") then return p end
    p=ch:FindFirstChild("HumanoidRootPart")
    if p and p:IsA("BasePart") then return p end
    return nil
end

