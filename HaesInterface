-- ═══════════════════════════════════════════════════════════
--  KEYBIND ENGINE
-- ═══════════════════════════════════════════════════════════
BIND.hold={} BIND.toggleUp={} BIND.cb={} BIND.feat={} BIND.listening=nil

function BIND.keyMatch(bind,input)
    if not bind or not bind.keys then return false end
    for _,k in ipairs(bind.keys) do
        if k.type=="key" then
            if input.UserInputType==Enum.UserInputType.Keyboard and input.KeyCode.Name==k.value then return true end
        elseif k.type=="mouse" then
            if k.value=="Button1" and input.UserInputType==Enum.UserInputType.MouseButton1 then return true end
            if k.value=="Button2" and input.UserInputType==Enum.UserInputType.MouseButton2 then return true end
        end
    end
    return false
end

function BIND.mode(feat)
    local b=C.binds[feat]
    return b and(b.mode or "Toggle") or "Toggle"
end

function BIND.apply(feat,v)
    if BIND.feat[feat] then pcall(BIND.feat[feat],v) end
end

function BIND.down(feat)
    local b=C.binds[feat]
    if not b or not b.keys or #b.keys==0 then return end
    if not C.toggled[feat] then return end
    local mode=BIND.mode(feat)
    if mode=="Toggle" then
        C._state[feat]=not C._state[feat] BIND.apply(feat,C._state[feat])
    elseif mode=="Hold" then
        if not BIND.hold[feat] then
            BIND.hold[feat]=true
            C._state[feat]=((b.holdAt or "On")=="On") BIND.apply(feat,C._state[feat])
        end
    elseif mode=="Always" then
        C._state[feat]=true BIND.apply(feat,true)
    end
    if BIND.toggleUp[feat] then BIND.toggleUp[feat]() end
end

function BIND.up(feat)
    local b=C.binds[feat] if not b then return end
    if BIND.mode(feat)=="Hold" and BIND.hold[feat] then
        BIND.hold[feat]=false
        if C.toggled[feat] then
            C._state[feat]=((b.holdAt or "On")=="Off") BIND.apply(feat,C._state[feat])
        end
    end
end

-- ═══════════════════════════════════════════════════════════
--  AIM ASSIST
-- ═══════════════════════════════════════════════════════════
AIM.spring=0.0
AIM.axis=Vector3.new(0,1,0)
AIM.acq=0
AIM.sticky=nil
AIM.active=nil
AIM.fovCircle=nil
AIM.fovState={vis=false,pos=Vector2.zero,radius=-1,color=Color3.new(),thickness=-1}

function AIM.reset()
    AIM.spring=0.0
    AIM.axis=Vector3.new(0,1,0)
    AIM.sticky=nil
    AIM.active=nil
end

function AIM.inFov(part,fov)
    local cam=getCam() if not cam then return nil end
    local vp=cam.ViewportSize
    local center=Vector2.new(vp.X*0.5,vp.Y*0.5)
    local sp,on,depth=U.w2v(part.Position)
    if not on or depth<0.1 then return nil end
    local dist=(sp-center).Magnitude
    if dist>fov then return nil end
    return sp,dist,depth
end

function AIM.getTarget(team,wall,knock,part,maxDist,fov,preferred)
    local myC=LP.Character if not myC then return nil end
    local myR=myC:FindFirstChild("HumanoidRootPart") if not myR then return nil end
    local myPos=myR.Position
    local best,bestScore=nil,math.huge
    for _,plr in ipairs(PLRS:GetPlayers()) do
        if plr==LP then continue end
        local ch=plr.Character if not ch then continue end
        local wl,bl,isT,knocked=U.info(plr,ch)
        if wl then continue end
        if team and isT and not bl then continue end
        local hum=ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        if knock and knocked then continue end
        local tp=U.resolvePart(ch,part) if not tp then continue end
        if (tp.Position-myPos).Magnitude>maxDist then continue end
        local sp,fovDist=AIM.inFov(tp,fov)
        if not sp then continue end
        if wall and not U.rayWall(ch,tp) then continue end
        local score=fovDist*(plr==preferred and 0.80 or 1.0)
        if score<bestScore then
            best={plr=plr,part=tp,sp=sp}
            bestScore=score
        end
    end
    return best
end

function AIM.iirAlpha(dt,smooth,shaping)
    local tau=math.max(smooth,0.0001)*0.02
    local raw=math.clamp(1.0-math.exp(-dt/tau),1e-4,1.0)
    if shaping=="Quadratic" then return raw*raw*(3.0-2.0*raw)
    elseif shaping=="Sine" then return math.sin(raw*math.pi*0.5) end
    return raw
end

function AIM.smoothCF(curCF,aimPos,smoothness,dt,mode)
    local toGoal=aimPos-curCF.Position
    if toGoal.Magnitude<1e-4 then AIM.spring=0.0 return curCF end

    local curLook=curCF.LookVector
    local goalDir=toGoal.Unit
    local dot=math.clamp(curLook:Dot(goalDir),-1.0,1.0)
    local totalAngle=math.acos(dot)
    if totalAngle<1e-5 then AIM.spring=0.0 return curCF end

    local axis=curLook:Cross(goalDir)
    if axis.Magnitude<1e-7 then
        local up=math.abs(curLook.Y)>0.9 and Vector3.new(1,0,0) or Vector3.new(0,1,0)
        axis=curLook:Cross(up)
        if axis.Magnitude<1e-7 then return curCF end
    end
    axis=axis.Unit
    if AIM.axis:Dot(axis)<0.5 then AIM.spring=0.0 end
    AIM.axis=axis

    local delta
    if mode=="Spring" then
        local omega=25.0/math.max(smoothness,0.1)
        local e,v=totalAngle,AIM.spring
        local steps=math.max(1,math.ceil(dt/0.004))
        local h=dt/steps
        for _=1,steps do
            local acc=-(omega*omega)*e-2.0*omega*v
            v=v+acc*h
            e=e+v*h
            if e<=0 then e=0 v=0 break end
        end
        AIM.spring=v
        delta=totalAngle-e
    else
        delta=totalAngle*AIM.iirAlpha(dt,smoothness,mode)
        AIM.spring=0.0
    end

    delta=math.min(delta,totalAngle)
    if delta<1e-7 then return curCF end

    local rot=CFrame.fromAxisAngle(axis,delta)
    return CFrame.new(curCF.Position)*(rot*(curCF-curCF.Position))
end

function AIM.validate(t,isSticky)
    if not t or not t.plr then return nil end
    local plr=t.plr
    local ch=plr.Character if not ch then return nil end
    local hum=ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return nil end
    local wl,bl,isT,knocked=U.info(plr,ch)
    if wl then return nil end
    if C.aaTeam and isT and not bl then return nil end
    if C.aaKnock and knocked then return nil end
    local part=U.resolvePart(ch,C.aaPart) if not part then return nil end
    local cam=getCam() if not cam then return nil end
    local dist=(part.Position-cam.CFrame.Position).Magnitude
    if dist>C.aaDist*(isSticky and 1.2 or 1.0) then return nil end
    local sp=AIM.inFov(part,isSticky and (C.aaFov*1.5) or C.aaFov)
    if not sp then return nil end
    if C.aaWall and not U.rayWall(ch,part) then return nil end
    return {plr=plr,part=part,dist=dist}
end

function AIM.tickFov()
    local fc=AIM.fovCircle if not fc then return end
    local cam=getCam() if not cam then return end
    local fs=AIM.fovState
    local show=C.aaFovShow
    if fs.vis~=show then fc.Visible=show fs.vis=show end
    if not show then return end
    local pos=Vector2.new(cam.ViewportSize.X*0.5,cam.ViewportSize.Y*0.5)
    if fs.pos~=pos then fc.Position=pos fs.pos=pos end
    if fs.radius~=C.aaFov then fc.Radius=C.aaFov fs.radius=C.aaFov end
    if fs.color~=C.aaFovCol then fc.Color=C.aaFovCol fs.color=C.aaFovCol end
    if fs.thickness~=C.aaFovThickness then fc.Thickness=C.aaFovThickness fs.thickness=C.aaFovThickness end
end

function AIM.tick(dt)
    AIM.tickFov()
    if CAM.owned then AIM.spring=0.0 return end
    if not isActive("aa") then AIM.reset() return end

    local cam=getCam() if not cam then return end
    local safeDt=math.clamp(dt,0.001,0.05)

    local t=nil
    if AIM.active then t=AIM.validate(AIM.active,C.aaSticky) end
    if not t and C.aaSticky and AIM.sticky then t=AIM.validate({plr=AIM.sticky},true) end

    if not t then
        local now=os.clock()
        if now-AIM.acq>=0.05 then
            AIM.acq=now
            local prev=C.aaSticky and AIM.sticky or nil
            t=AIM.getTarget(C.aaTeam,C.aaWall,C.aaKnock,C.aaPart,C.aaDist,C.aaFov,prev)
        end
    end

    if AIM.active and (not t or AIM.active.plr~=t.plr) then
        AIM.spring=0.0
        AIM.axis=Vector3.new(0,1,0)
    end
    AIM.active=t
    if C.aaSticky and t then AIM.sticky=t.plr else AIM.sticky=nil end

    if not t then
        AIM.spring=AIM.spring*math.max(0.0,1.0-safeDt*20.0)
        return
    end

    local aimPos=t.part.Position
    local root=t.plr.Character and t.plr.Character:FindFirstChild("HumanoidRootPart")
    if root then
        local vel=root.AssemblyLinearVelocity
        if vel.Magnitude>0.5 then
            aimPos=aimPos+vel*math.clamp(C.aaPrediction,0.0,1.0)
        end
    end

    local newCF=AIM.smoothCF(cam.CFrame,aimPos,C.aaSmooth,safeDt,C.aaSmoothMode)
    if newCF then cam.CFrame=newCF end
end

-- ═══════════════════════════════════════════════════════════
--  SILENT AIM  (fully separate from aim assist: own target
--  selection, own config keys, own state, own hook)
--  modes: Raycast (WS:Raycast redirect + No Spread),
--         Mouse (mouse.aim.Hit / Target),
--         Viewport (camera ViewportPointToRay / ScreenPointToRay)
-- ═══════════════════════════════════════════════════════════
local SA={}
SA.st=_G.__HAES_SILENT or {on=false,pos=nil,part=nil,mode="Raycast",noSpread=1}
SA.st.on=false SA.st.pos=nil SA.st.part=nil
SA.st.noSpread=SA.st.noSpread or 1
_G.__HAES_SILENT=SA.st
SA.cur=nil
SA.acq=0
SA.stick=nil

function SA.clear()
    SA.st.on=false SA.st.pos=nil SA.st.part=nil
    SA.cur=nil
end

-- closest valid player inside the silent FOV, using silent settings only
function SA.pick()
    local myC=LP.Character if not myC then return nil end
    local myR=myC:FindFirstChild("HumanoidRootPart") if not myR then return nil end
    local cam=getCam() if not cam then return nil end
    local vp=cam.ViewportSize
    local center=Vector2.new(vp.X*0.5,vp.Y*0.5)
    local best,bestD=nil,math.huge
    for _,plr in ipairs(PLRS:GetPlayers()) do
        if plr==LP then continue end
        local ch=plr.Character if not ch then continue end
        local wl,bl,isT,knocked=U.info(plr,ch)
        if wl then continue end
        if C.silentTeam and isT and not bl then continue end
        local hum=ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        if C.silentKnock and knocked then continue end
        local tp=U.resolvePart(ch,C.silentPart) if not tp then continue end
        if (tp.Position-myR.Position).Magnitude>C.silentDist then continue end
        local sp,on,depth=U.w2v(tp.Position)
        if not on or depth<0.1 then continue end
        local d=(sp-center).Magnitude
        if d>C.silentFov then continue end
        if C.silentWall and not U.rayWall(ch,tp) then continue end
        if d<bestD then best={plr=plr,part=tp} bestD=d end
    end
    return best
end

-- hooks install once per executor session. every mode reads the shared
-- _G.__HAES_SILENT state, so slider and dropdown changes apply on the next call.
function SA.install()
    local okR,okM=_G.__HAES_SA_NC or false,_G.__HAES_SA_IDX or false
    if type(hookmetamethod)~="function" or type(getnamecallmethod)~="function"
        or type(newcclosure)~="function" or type(checkcaller)~="function" then
        return okR,okM
    end

    if not okR then
        okR=pcall(function()
            local oldNC
            oldNC=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
                local st=_G.__HAES_SILENT
                if not st or not st.on or not st.pos or checkcaller() then
                    return oldNC(self,...)
                end
                local m=getnamecallmethod()

                -- Raycast: redirect WS:Raycast, keep (1 - noSpread) of the weapon's spread offset
                if st.mode=="Raycast" and self==WS and m=="Raycast" then
                    local origin,dir=...
                    if typeof(origin)=="Vector3" and typeof(dir)=="Vector3" and dir.Magnitude>0.01 then
                        local want=st.pos-origin
                        local cam=WS.CurrentCamera
                        if want.Magnitude>0.01 and cam then
                            local spread=dir.Unit-cam.CFrame.LookVector
                            local keep=1-math.clamp(st.noSpread or 1,0,1)
                            local newDir=want.Unit+spread*keep
                            if newDir.Magnitude>1e-4 then
                                return oldNC(self,origin,newDir.Unit*dir.Magnitude,select(3,...))
                            end
                        end
                    end

                -- Viewport: camera rays from screen space point at the target
                elseif st.mode=="Viewport" and (m=="ViewportPointToRay" or m=="ScreenPointToRay")
                    and self==WS.CurrentCamera then
                    local o=self.CFrame.Position
                    local d=st.pos-o
                    if d.Magnitude>0.01 then
                        return Ray.new(o,d.Unit*1000)
                    end
                end

                return oldNC(self,...)
            end))
        end)
        if okR then _G.__HAES_SA_NC=true end
    end

    if not okM then
        okM=pcall(function()
            local oldIdx
            oldIdx=hookmetamethod(mouse.aim,"__index",newcclosure(function(self,k)
                local st=_G.__HAES_SILENT
                if st and st.on and st.pos and st.mode=="Mouse" and not checkcaller() then
                    if k=="Hit" then return CFrame.new(st.pos) end
                    if k=="Target" then return st.part end
                end
                if type(oldIdx)=="function" then return oldIdx(self,k) end
                return oldIdx[k]
            end))
        end)
        if okM then _G.__HAES_SA_IDX=true end
    end

    return okR,okM
end

-- true while a locked silent target still passes every silent filter
local function saValid(plr,part)
    if not plr or not plr.Parent or not part or not part.Parent then return false end
    local ch=plr.Character if not ch then return false end
    if not part:IsDescendantOf(ch) then return false end
    local hum=ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return false end
    local wl,bl,isT,knocked=U.info(plr,ch)
    if wl then return false end
    if C.silentTeam and isT and not bl then return false end
    if C.silentKnock and knocked then return false end
    local myR=getRoot() if not myR then return false end
    if (part.Position-myR.Position).Magnitude>C.silentDist*1.2 then return false end
    local cam=getCam() if not cam then return false end
    local vp=cam.ViewportSize
    local sp,on,depth=U.w2v(part.Position)
    if not on or depth<0.1 then return false end
    if (sp-Vector2.new(vp.X*0.5,vp.Y*0.5)).Magnitude>C.silentFov*1.5 then return false end
    if C.silentWall and not U.rayWall(ch,part) then return false end
    return true
end

-- runs every render frame; keeps SA.st current with the chosen target, mode and spread
function SA.tick()
    SA.st.noSpread=math.clamp(C.silentNoSpread,0,100)/100
    if not isActive("sa") then
        if SA.st.on then SA.clear() end
        SA.stick=nil
        return
    end
    if not C.silentSticky then SA.stick=nil end

    local t=nil
    if C.silentSticky and SA.stick then
        local tp=U.resolvePart(SA.stick.Character,C.silentPart)
        if tp and saValid(SA.stick,tp) then t={plr=SA.stick,part=tp} end
        if not t then SA.stick=nil end
    end

    if not t then
        local now=os.clock()
        if now-SA.acq>=0.05 then
            SA.acq=now
            t=SA.pick()
        end
    end

    if not t then SA.clear() return end
    if C.silentSticky then SA.stick=t.plr end

    local pos=t.part.Position
    local root=t.plr.Character and t.plr.Character:FindFirstChild("HumanoidRootPart")
    if root then
        local v=root.AssemblyLinearVelocity
        if v.Magnitude>0.5 then pos=pos+v*math.clamp(C.silentPred,0.0,1.0) end
    end
    SA.st.on=true
    SA.st.pos=pos
    SA.st.part=t.part
    SA.st.mode=C.silentMode
end

