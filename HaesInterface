TM.attrs={"Team","TeamId","TeamName","Crew","CrewName","CrewId","Gang","GangName","GangId","Faction","FactionName","GroupId","Group","Organization","Org","Clan","ClanName"}
TM.children={"Crew","CrewName","Gang","GangName","Team","TeamName","Faction","FactionName","Group","Clan","ClanName","Organization","Org"}
TM.sig=nil TM.sigT=0

function TM.norm(v)
    if v==nil then return nil end
    local s=tostring(v):lower():gsub("%s+","")
    if s==""or s=="0"or s=="none"or s=="nil"or s=="null"or s=="solo"or s=="false"or s=="noteam"or s=="no-team"or s=="neutral"or s=="nomad" then return nil end
    return s
end

function TM.eq(a,b)
    local na,nb=TM.norm(a),TM.norm(b)
    if na==nil or nb==nil then return false end
    return na==nb
end

function TM.localSig()
    local now=os.clock()
    if TM.sig and now-TM.sigT<1.0 then return TM.sig end
    local myChar=LP.Character local checks={}
    for _,attr in ipairs(TM.attrs) do
        local v=TM.norm(LP:GetAttribute(attr))
        if v then checks[#checks+1]={src="player",key=attr,value=v,child=false} end
        if myChar then
            local cv=TM.norm(myChar:GetAttribute(attr))
            if cv then checks[#checks+1]={src="char",key=attr,value=cv,child=false} end
        end
    end
    for _,name in ipairs(TM.children) do
        local obj=LP:FindFirstChild(name)
        if obj and obj:IsA("ValueBase") then
            local v=TM.norm(obj.Value)
            if v then checks[#checks+1]={src="player",key=name,value=v,child=true} end
        end
        if myChar then
            local cobj=myChar:FindFirstChild(name)
            if cobj and cobj:IsA("ValueBase") then
                local v=TM.norm(cobj.Value)
                if v then checks[#checks+1]={src="char",key=name,value=v,child=true} end
            end
        end
    end
    TM.sig=checks TM.sigT=now
    return checks
end

function TM.matches(p,checks)
    if not p or #checks==0 then return false end
    local plrChar=p.Character
    for _,check in ipairs(checks) do
        local src
        if check.src=="char" then src=plrChar else src=p end
        if src then
            local their
            if check.child then
                local obj=src:FindFirstChild(check.key)
                if obj and obj:IsA("ValueBase") then their=obj.Value end
            else
                their=src:GetAttribute(check.key)
            end
            if their~=nil and TM.eq(check.value,their) then return true end
        end
    end
    return false
end

function TM.isTeam(p)
    if not p or not p.Character then return false end
    if LP.Team~=nil and p.Team~=nil and LP.Team==p.Team then return true end
    return TM.matches(p,TM.localSig())
end

