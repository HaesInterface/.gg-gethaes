function U.validEnemy(plr,ch,team,knock,wall,hitPart)
    local wl,bl,isT,knocked=U.info(plr,ch)
    if wl then return false end
    if team and isT and not bl then return false end
    local hum=ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return false end
    if knock and knocked then return false end
    if wall then
        local cp=hitPart
        if not cp or not cp:IsA("BasePart") then cp=U.resolvePart(ch,"Head") end
        if cp and not U.rayWall(ch,cp) then return false end
    end
    return true
end

