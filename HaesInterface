MV.baseWalk=nil

function MV.stopFly()
    if MV.flyConn then MV.flyConn:Disconnect() MV.flyConn=nil end
    if MV.flyBody then
        pcall(function() MV.flyBody.bv:Destroy() end)
        pcall(function() MV.flyBody.bg:Destroy() end)
        MV.flyBody=nil
    end
    local hum=getHum()
    if hum then hum.PlatformStand=false hum.WalkSpeed=MV.origWalk or 16 MV.origWalk=nil end
end

function MV.startFly()
    local root=getRoot() local hum=getHum()
    if not root or not hum then return end
    if not MV.origWalk then MV.origWalk=hum.WalkSpeed end
    hum.WalkSpeed=0 hum.PlatformStand=true
    if MV.flyBody then
        pcall(function() MV.flyBody.bv:Destroy() end)
        pcall(function() MV.flyBody.bg:Destroy() end)
    end
    local bv=Instance.new("BodyVelocity")
    bv.Name="HaesFlyBV" bv.Velocity=Vector3.zero
    bv.MaxForce=Vector3.new(1e5,1e5,1e5) bv.P=1e4 bv.Parent=root
    local bg=Instance.new("BodyGyro")
    bg.Name="HaesFlyBG" bg.CFrame=root.CFrame
    bg.MaxTorque=Vector3.new(1e5,1e5,1e5) bg.P=5000 bg.D=200 bg.Parent=root
    MV.flyBody={bv=bv,bg=bg}
    if MV.flyConn then MV.flyConn:Disconnect() MV.flyConn=nil end
    MV.flyConn=RUN.RenderStepped:Connect(function()
        local cam=getCam() if not cam then return end
        local cf=cam.CFrame local vel=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then vel=vel+cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then vel=vel-cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then vel=vel-cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then vel=vel+cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vel=vel+Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vel=vel-Vector3.new(0,1,0) end
        if vel.Magnitude>0 then vel=vel.Unit*C.flySpeed end
        if bv.Parent then bv.Velocity=vel end
        if bg.Parent then bg.CFrame=CFrame.new(root.Position,root.Position+cf.LookVector) end
    end)
end

function MV.stopSpeed()
    if MV.speedConn then MV.speedConn:Disconnect() MV.speedConn=nil end
    local hum=getHum()
    if hum and not C._state.flyOn and MV.baseWalk then hum.WalkSpeed=MV.baseWalk end
    MV.baseWalk=nil
end

function MV.startSpeed()
    if MV.speedConn then MV.speedConn:Disconnect() MV.speedConn=nil end
    if C._state.flyOn then return end
    local hum=getHum()
    if hum and not MV.baseWalk then MV.baseWalk=hum.WalkSpeed end
    MV.speedConn=RUN.Stepped:Connect(function()
        if C._state.flyOn then return end
        local h=getHum() if not h then return end
        if not MV.baseWalk then MV.baseWalk=h.WalkSpeed end
        local want=MV.baseWalk*C.speedMult
        if math.abs(h.WalkSpeed-want)>0.05 then h.WalkSpeed=want end
    end)
end

function MV.applyJump()
    local hum=getHum() if not hum then return end
    if not MV.origJump then MV.origJump=hum.UseJumpPower and hum.JumpPower or hum.JumpHeight end
    if hum.UseJumpPower then hum.JumpPower=C.jumpPower else hum.JumpHeight=C.jumpPower*0.31 end
end

function MV.stopJump()
    local hum=getHum()
    if hum and MV.origJump then
        if hum.UseJumpPower then hum.JumpPower=MV.origJump else hum.JumpHeight=MV.origJump end
    end
    MV.origJump=nil
end

function MV.startInf()
    if MV.infConn then MV.infConn:Disconnect() MV.infConn=nil end
    MV.infConn=UIS.JumpRequest:Connect(function()
        local hum=getHum() if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
end

function MV.stopInf()
    if MV.infConn then MV.infConn:Disconnect() MV.infConn=nil end
end

function MV.startNoclip()
    if MV.noclipConn then MV.noclipConn:Disconnect() MV.noclipConn=nil end
    MV.noclipTick=0
    MV.noclipConn=RUN.Stepped:Connect(function()
        MV.noclipTick=(MV.noclipTick+1)%3
        if MV.noclipTick~=0 then return end
        local ch=LP.Character if not ch then return end
        for _,p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                if MV.noclipSaved[p]==nil then MV.noclipSaved[p]=true end
                p.CanCollide=false
            end
        end
    end)
end

function MV.stopNoclip()
    if MV.noclipConn then MV.noclipConn:Disconnect() MV.noclipConn=nil end
    for p in pairs(MV.noclipSaved) do pcall(function() p.CanCollide=true end) end
    MV.noclipSaved={}
end

