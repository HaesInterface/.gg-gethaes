            regT(numBox,"TextColor3")
            local trkBg=Instance.new("Frame",row)
            trkBg.Size=UDim2.new(1,-90,0,3) trkBg.Position=UDim2.new(0,20,0.5,-1)
            trkBg.BackgroundColor3=Color3.fromRGB(28,28,36) trkBg.BorderSizePixel=0 trkBg.ZIndex=5
            Instance.new("UICorner",trkBg).CornerRadius=UDim.new(1,0)
            local fill=Instance.new("Frame",trkBg)
            fill.Size=UDim2.new(cur[idx],0,1,0) fill.BackgroundColor3=ACC() fill.BorderSizePixel=0 fill.ZIndex=6
            Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
            regT(fill,"BackgroundColor3")
            local thm=Instance.new("Frame",trkBg)
            thm.Size=UDim2.new(0,8,0,8) thm.AnchorPoint=Vector2.new(0.5,0.5)
            thm.Position=UDim2.new(cur[idx],0,0.5,0)
            thm.BackgroundColor3=Color3.new(1,1,1) thm.BorderSizePixel=0 thm.ZIndex=7
            Instance.new("UICorner",thm).CornerRadius=UDim.new(1,0)
            local trackBtn=Instance.new("TextButton",row)
            trackBtn.Size=UDim2.new(1,-90,0,18) trackBtn.Position=UDim2.new(0,20,0.5,-9)
            trackBtn.BackgroundTransparency=1 trackBtn.Text="" trackBtn.ZIndex=8 trackBtn.AutoButtonColor=false
            local function setVal(v)
                v=math.clamp(v,0,1) cur[idx]=v
                fill.Size=UDim2.new(v,0,1,0) thm.Position=UDim2.new(v,0,0.5,0)
                numBox.Text=tostring(math.floor(v*255)) emit()
            end
            setters[idx]=setVal
            numBox.Focused:Connect(function() nS.Color=ACC() end)
            numBox.FocusLost:Connect(function()
                nS.Color=BORDER
                local n=tonumber(numBox.Text)
                if n then setVal(math.clamp(n,0,255)/255) else numBox.Text=tostring(math.floor(cur[idx]*255)) end
            end)
            trackBtn.MouseButton1Down:Connect(function()
                local function fromX(sx)
                    local sz=trackBtn.AbsoluteSize.X if sz<=0 then return end
                    setVal(math.clamp((sx-trackBtn.AbsolutePosition.X)/sz,0,1))
                end
                fromX(mouse.aim.X)
                local dragging=true local c1,c2
                c1=UIS.InputChanged:Connect(function(inp)
                    if not dragging then return end
                    if inp.UserInputType==Enum.UserInputType.MouseMovement then fromX(inp.Position.X) end
                end)
                c2=UIS.InputEnded:Connect(function(inp)
                    if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                        dragging=false
                        if c1 then c1:Disconnect() end
                        if c2 then c2:Disconnect() end
                    end
                end)
            end)
        end
        mkChannel("R",1,Color3.fromRGB(220,90,90))
        mkChannel("G",2,Color3.fromRGB(90,220,90))
        mkChannel("B",3,Color3.fromRGB(90,140,220))
        if configKey then
            UI_Update[configKey]=function(v)
                local r,g,b
                if typeof(v)=="Color3" then r,g,b=v.R,v.G,v.B
                elseif type(v)=="table" and #v==3 then r,g,b=v[1],v[2],v[3]
                else return end
                if setters[1] then setters[1](r) end
                if setters[2] then setters[2](g) end
                if setters[3] then setters[3](b) end
            end
        end
    end

