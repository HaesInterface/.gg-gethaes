    end
    dump("PERMANENT (100)",KEYS.perm) dump("MONTHLY (100)",KEYS.mnth)
    dump("WEEKLY (100)",KEYS.week)    dump("DAILY (100)",KEYS.day1)
    print("\n400 keys total | Built by Haes")
end

local LICENCE_FILE="haes_v2_licence.json"
local function getDeviceID()
    if type(gethwid)=="function" then local ok,h=pcall(gethwid) if ok and h then return "HWID_"..h end end
    if type(get_hwid)=="function" then local ok,h=pcall(get_hwid) if ok and h then return "HWID_"..h end end
    if type(syn)=="table" and type(syn.get_hwid)=="function" then local ok,h=pcall(syn.get_hwid) if ok and h then return "HWID_"..h end end
    local df="haes_device_id.txt"
    if type(readfile)=="function" then local ok,id=pcall(readfile,df) if ok and id and #id>5 then return "FILE_"..id end end
    local chars="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local newId=""
    for _=1,32 do local i=math.random(1,#chars) newId=newId..chars:sub(i,i) end
    if type(writefile)=="function" then pcall(writefile,df,newId) end
    return "FILE_"..newId
end
local function readJson(file)
    if type(readfile)~="function" then return nil end
    local ok,raw=pcall(readfile,file) if not ok or not raw or raw=="" then return nil end
    local d pcall(function() d=HS:JSONDecode(raw) end) return d
end
local function writeJson(file,data)
    if type(writefile)~="function" then return end
    pcall(writefile,file,HS:JSONEncode(data))
end
local function getActivation(key)
    local d=readJson(LICENCE_FILE)
    if not d or d.key~=key then return nil end
    if d.userId and tostring(d.userId)==tostring(LP.UserId) then
        d.hwid=getDeviceID() writeJson(LICENCE_FILE,d) return d.activated
    end
    local cur=getDeviceID()
    if d.hwid and d.hwid~=cur then return "HWID_MISMATCH" end
    return d.activated
end
local function setActivation(key)
    writeJson(LICENCE_FILE,{key=key,activated=os.time(),hwid=getDeviceID(),player=LP.Name,userId=LP.UserId})
end
local function validateKey(key)
    key=key:upper():gsub("%s+","")
    if KEYS.perm[key] then
        local act=getActivation(key)
        if act=="HWID_MISMATCH" then return{valid=false,tier=nil,label="LICENSE BOUND TO ANOTHER DEVICE"} end
        if not act then setActivation(key) end
        return{valid=true,tier="PERMANENT",label="∞",remaining=-1,expiresAt=-1}
    end
    local function tc(set,dur,tier)
        if not set[key] then return nil end
        local act=getActivation(key)
        if act=="HWID_MISMATCH" then return{valid=false,tier=tier,label="LICENSE BOUND TO ANOTHER DEVICE"} end
        if not act then setActivation(key) act=os.time() end
        local rem=act+dur-os.time()
        if rem<=0 then return{valid=false,tier=tier,label="EXPIRED",remaining=0} end
        local d=math.floor(rem/86400) local h=math.floor((rem%86400)/3600) local m=math.floor((rem%3600)/60)
        local label=d>0 and(d.."d "..h.."h") or(h>0 and(h.."h "..m.."m")or(m.."m"))
        return{valid=true,tier=tier,label=label,remaining=rem,expiresAt=act+dur}
    end
    return tc(KEYS.mnth,30*86400,"MONTHLY") or tc(KEYS.week,7*86400,"WEEKLY")
        or tc(KEYS.day1,86400,"DAILY") or{valid=false,tier=nil,label="INVALID KEY"}
end
local function formatDate(ts)
    if not ts or ts<=0 then return "∞" end
    local MONTHS={"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"}
    local d=os.date("*t",ts)
    return MONTHS[d.month].." "..d.day..", "..d.year
end

