    local function serializeConfig()
        local snap={}
        for k,v in pairs(C) do
            if type(v)=="number" or type(v)=="boolean" or type(v)=="string" then snap[k]=v
            elseif typeof(v)=="Color3" then snap[k]={v.R,v.G,v.B} end
        end
        snap.whitelist={} for k,v in pairs(C.whitelist) do snap.whitelist[k]=v end
        snap.blacklist={} for k,v in pairs(C.blacklist) do snap.blacklist[k]=v end
        snap._state={} for k,v in pairs(C._state) do snap._state[k]=v end
        snap.toggled={} for k,v in pairs(C.toggled) do snap.toggled[k]=v end
        snap.binds={}
        for feat,bind in pairs(C.binds) do
            snap.binds[feat]={mode=bind.mode or "Toggle",holdAt=bind.holdAt or "On",keys={}}
            if bind.keys then
                for _,key in ipairs(bind.keys) do
                    snap.binds[feat].keys[#snap.binds[feat].keys+1]={type=key.type,value=key.value}
                end
            end
        end
        return snap
    end

    local function applyConfig(cfg)
        for k,v in pairs(cfg) do
            if type(C[k])=="number" and type(v)=="number" then C[k]=v
            elseif type(C[k])=="boolean" and type(v)=="boolean" then C[k]=v
            elseif type(C[k])=="string" and type(v)=="string" then C[k]=v
            elseif typeof(C[k])=="Color3" then
                if typeof(v)=="Color3" then C[k]=v
                elseif type(v)=="table" and #v==3 then C[k]=Color3.new(v[1],v[2],v[3]) end
            end
        end
        if type(cfg.whitelist)=="table" then
            C.whitelist={} for k,v in pairs(cfg.whitelist) do C.whitelist[k]=v end
        end
        if type(cfg.blacklist)=="table" then
            C.blacklist={} for k,v in pairs(cfg.blacklist) do C.blacklist[k]=v end
        end
        if type(cfg._state)=="table" then for k,v in pairs(cfg._state) do C._state[k]=v end end
        if type(cfg.toggled)=="table" then for k,v in pairs(cfg.toggled) do C.toggled[k]=v end end
        if type(cfg.binds)=="table" then
            C.binds={}
            for feat,bind in pairs(cfg.binds) do
                C.binds[feat]={mode=bind.mode or "Toggle",holdAt=bind.holdAt or "On",keys={}}
                if type(bind.keys)=="table" then
                    for _,key in ipairs(bind.keys) do
                        C.binds[feat].keys[#C.binds[feat].keys+1]={type=key.type,value=key.value}
                    end
                end
            end
        end
        for feat in pairs(BIND.hold) do BIND.hold[feat]=false end
        AIM.reset()
        SA.clear()
        SA.stick=nil
        SA.st.noSpread=math.clamp(C.silentNoSpread,0,100)/100
        applyTheme()
        for key,updater in pairs(UI_Update) do
            if not key:find("_state_") and C[key]~=nil then pcall(updater,C[key]) end
        end
        -- fillBoxOpacity is not a C key, so the generic loop skips it
        if UI_Update["fillBoxOpacity"] then pcall(UI_Update["fillBoxOpacity"],C.fillBoxOpacity) end
        for _,u in pairs(BIND.toggleUp) do pcall(u) end
        for _,cb in pairs(BIND.cb) do pcall(cb) end
        for feat,cb in pairs(BIND.feat) do pcall(cb,C._state[feat] or false) end
        if UI_Update["_state_esp"] then UI_Update["_state_esp"](C._state.esp) end
        PC.invalidate()
    end

